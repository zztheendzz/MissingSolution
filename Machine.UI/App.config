<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--Æô¶¯·þÎñÐÎÊ½(0´ú±íÄ¬ÈÏÏµÍ³·þÎñ, 1´ú±íexe·½Ê½Æô¶¯)-->
    <add key="StartServerByExe" value="0" />
